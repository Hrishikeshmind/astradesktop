# Single source of truth for MAR product-info channel IDs.
# Format: <surfer-brand / AUS channel>=<MAR_CHANNEL_ID>
#
# MAR_CHANNEL_ID baked into a .mar MUST equal ACCEPTED_MAR_CHANNEL_IDS in the
# packaged app's update-settings.ini. Never widen ACCEPTED_MAR_CHANNEL_IDS to
# paper over a mismatched MAR — that defeats the anti-tamper check.
#
# Every MAR build/verify script MUST read this file via scripts/astra_channel.py.
# Do not hardcode channel strings in workflows or packaging scripts.

release=release
twilight=twilight
