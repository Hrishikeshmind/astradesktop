+function bindChatLoading(browser) {
+  const hide = () => {
+    hideChatLoading();
+    if (browser._astraLoadTimer) {
+      clearTimeout(browser._astraLoadTimer);
+      browser._astraLoadTimer = null;
+    }
+  };
+  browser.addEventListener("load", hide, true);
+  try {
+    const listener = {
+      QueryInterface: ChromeUtils.generateQI([
+        "nsIWebProgressListener",
+        "nsISupportsWeakReference",
+      ]),
+      onStateChange(_progress, _request, flags) {
+        const wpl = Ci.nsIWebProgressListener;
+        if (
+          flags & wpl.STATE_STOP &&
+          flags & wpl.STATE_IS_WINDOW
+        ) {
+          hide();
+        }
+      },
+    };
+    browser.addProgressListener(
+      listener,
+      Ci.nsIWebProgress.NOTIFY_STATE_WINDOW
+    );
+  } catch (ex) {
+    console.warn("Astra chat loading listener", ex);
+  }
+  browser._astraLoadTimer = setTimeout(hide, 4500);
+}
