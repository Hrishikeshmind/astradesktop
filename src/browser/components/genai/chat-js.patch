+function updateProviderChrome() {
+  const icon = document.getElementById("provider-icon");
+  const info = lazy.GenAI.chatProviders.get(lazy.providerPref);
+  const id = info?.id || "";
+  document.body.dataset.provider = id;
+  document.body.toggleAttribute("astra-has-provider", !!lazy.providerPref);
+  if (!icon) {
+    return;
+  }
+  if (info?.iconUrl) {
+    icon.hidden = false;
+    icon.style.backgroundImage = `url("${info.iconUrl}")`;
+  } else {
+    icon.hidden = true;
+    icon.style.backgroundImage = "";
+  }
